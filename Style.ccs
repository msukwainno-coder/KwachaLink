
/* =========================================
   KWACHALINK — GLOBAL STYLES
   Brand: Bright Navy + Yellow + White
========================================= */

:root {
    --navy: #0057FF;
    --navy-dark: #003BC4;
    --yellow: #FFD84D;
    --white: #FFFFFF;
    --gray-white: #F2F5F7;
    --gray: #667085;
    --text: #182230;
    --border: #E1E7EF;
    --success: #18864B;
    --whatsapp: #25D366;
    --radius: 16px;
    --shadow: 0 8px 28px rgba(0, 55, 150, 0.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    margin: 0;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    color: var(--text);
    background: var(--white);
    line-height: 1.6;
}

body,
button,
input,
select,
textarea {
    font-family: Inter, "Segoe UI", Arial, sans-serif;
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    cursor: pointer;
}

button,
input,
select,
textarea {
    font-size: inherit;
}

button:focus-visible,
a:focus-visible,
select:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
}

[hidden] {
    display: none !important;
}

.container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* =========================================
   BUTTONS
========================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
    transition: transform .2s ease, background .2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--navy);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--navy-dark);
}

.btn-outline {
    background: var(--white);
    color: var(--navy);
    border-color: var(--navy);
}

.btn-outline:hover {
    background: #EEF4FF;
}

.btn-yellow {
    background: var(--yellow);
    color: #17212B;
}

.btn-yellow:hover {
    background: #FFCE24;
}

.btn-large {
    padding: 15px 22px;
}

.btn-whatsapp {
    color: #116B38;
    background: #E8FFF0;
    border-color: #B7EAC8;
}

.btn-whatsapp:hover {
    background: #D5F9E1;
}

/* =========================================
   HEADER
========================================= */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.brand {
    flex-shrink: 0;
}

.brand-logo {
    width: 185px;
    max-height: 56px;
    object-fit: contain;
}

.logo-dark {
    display: none;
}

.main-navigation {
    display: flex;
    align-items: center;
    gap: 22px;
}

.nav-link {
    color: #344054;
    font-size: .92rem;
    font-weight: 600;
    white-space: nowrap;
}

.nav-link:hover,
.nav-link.active {
    color: var(--navy);
}

.language-selector select {
    min-width: 64px;
    padding: 9px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--white);
    font-weight: 700;
}

.header-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

.mobile-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--white);
}

.mobile-menu-toggle span {
    display: block;
    height: 2px;
    width: 20px;
    margin: 4px auto;
    background: var(--navy);
}

/* =========================================
   HERO
========================================= */

.hero-section {
    overflow: hidden;
    background: linear-gradient(125deg, #EEF4FF 0%, #FFFFFF 68%);
    padding: 75px 0 85px;
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: 65px;
}

.eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: var(--navy);
    font-size: .77rem;
    font-weight: 800;
    letter-spacing: 1.6px;
}

.hero-content h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(2.5rem, 4.5vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -2px;
    font-weight: 850;
}

.hero-content h1 span {
    color: var(--navy);
}

.hero-description {
    max-width: 600px;
    margin: 24px 0;
    color: var(--gray);
    font-size: 1.08rem;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
}

.hero-trust-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 25px;
    color: var(--gray);
    font-size: .9rem;
}

.trust-dot {
    width: 9px;
    height: 9px;
    background: var(--navy);
    border-radius: 50%;
}

.hero-visual {
    min-height: 420px;
    position: relative;
}

.hero-image-main {
    position: absolute;
    inset: 0 28px 35px 20px;
    overflow: hidden;
    border-radius: 26px;
    background: var(--navy);
    box-shadow: var(--shadow);
}

.hero-image-main img,
.hero-image-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-image-secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    height: 42%;
    overflow: hidden;
    border: 7px solid var(--white);
    border-radius: 22px;
    box-shadow: var(--shadow);
    background: #DCE9FF;
}

.hero-floating-card {
    position: absolute;
    left: 0;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 270px;
    padding: 15px;
    border-radius: 14px;
    background: var(--white);
    box-shadow: var(--shadow);
}

.floating-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    background: var(--yellow);
    border-radius: 12px;
    color: var(--navy);
    font-size: 1.7rem;
    font-weight: 800;
}

.hero-floating-card strong {
    display: block;
    font-size: .92rem;
}

.hero-floating-card p {
    margin: 2px 0 0;
    color: var(--gray);
    font-size: .75rem;
}

/* =========================================
   SECTION HEADINGS
========================================= */

.section-heading {
    margin-bottom: 35px;
}

.section-heading h2,
.post-cta-content h2,
.subscription-content h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -.7px;
}

.section-heading p {
    max-width: 650px;
    margin: 14px 0 0;
    color: var(--gray);
}

.centered {
    text-align: center;
}

.centered p {
    margin-inline: auto;
}

/* =========================================
   FEATURES
========================================= */

.features-section {
    padding: 78px 0;
    background: var(--white);
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.feature-item {
    padding: 25px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    transition: transform .2s ease, box-shadow .2s ease;
}

.feature-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.feature-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 18px;
    border-radius: 14px;
    background: #EAF1FF;
    color: var(--navy);
    font-size: 1.8rem;
    font-weight: 800;
}

.feature-item h3 {
    margin: 0 0 9px;
    font-size: 1.06rem;
}

.feature-item p {
    margin: 0;
    color: var(--gray);
    font-size: .92rem;
}

/* =========================================
   MARKETPLACE
========================================= */

.marketplace-section {
    padding: 80px 0;
    background: var(--gray-white);
}

.marketplace-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
}

.text-link {
    color: var(--navy);
    font-weight: 800;
    white-space: nowrap;
}

.marketplace-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
}

.filter-btn {
    padding: 10px 16px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--white);
    color: #475467;
    font-weight: 700;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
}

.listings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.listing-card {
    min-width: 0;
    padding: 22px;
    border: 1px solid #E7EAF0;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 3px 12px rgba(16, 24, 40, .025);
    transition: transform .2s ease, box-shadow .2s ease;
}

.listing-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
}

.listing-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 20px;
}

.listing-type,
.listing-status,
.listing-currency span:first-child {
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    padding: 6px 9px;
    font-size: .73rem;
    font-weight: 800;
}

.exchange-tag {
    color: var(--navy);
    background: #EAF1FF;
}

.payment-tag {
    color: #785A00;
    background: #FFF4C7;
}

.listing-status {
    padding: 4px 0;
    color: var(--gray);
    background: transparent;
    font-weight: 600;
}

.listing-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
}

.profile-avatar {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    background: #EAF1FF;
}

.profile-information h3 {
    margin: 0;
    font-size: .98rem;
}

.profile-information span {
    display: block;
    margin-top: 3px;
    color: var(--gray);
    font-size: .8rem;
}

.listing-description {
    min-height: 76px;
    margin: 0 0 18px;
    font-size: .95rem;
    font-weight: 600;
    line-height: 1.6;
}

.listing-amount {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 15px;
    border-radius: 12px;
    background: #F7F9FC;
}

.listing-amount span {
    color: var(--gray);
    font-size: .8rem;
}

.listing-amount strong {
    color: var(--navy);
    font-size: 1.35rem;
    overflow-wrap: anywhere;
}

.listing-currency {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 15px 0;
    color: var(--gray);
    font-size: .82rem;
}

.listing-currency span:first-child {
    color: #344054;
    background: #F2F5F7;
}

.listing-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    margin-top: 20px;
}

.listing-actions .btn {
    min-width: 0;
    padding: 12px 8px;
    font-size: .85rem;
}

.marketplace-bottom {
    margin-top: 35px;
    text-align: center;
}

/* =========================================
   POST CTA
========================================= */

.post-cta-section {
    padding: 75px 0;
    background: var(--navy);
    color: var(--white);
}

.post-cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
}

.post-cta-content .eyebrow {
    color: var(--yellow);
}

.post-cta-content h2 {
    max-width: 650px;
}

.post-cta-content p {
    max-width: 670px;
    margin: 15px 0 0;
    color: #E3EBFF;
}

/* =========================================
   SUBSCRIPTION
========================================= */

.subscription-section {
    padding: 80px 0;
    background: var(--white);
}

.subscription-card {
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    gap: 45px;
    padding: 40px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: #F9FBFF;
}

.subscription-content > p {
    max-width: 600px;
    color: var(--gray);
}

.subscription-benefits {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 25px 0 0;
    list-style: none;
}

.subscription-benefits li::before {
    content: "✓";
    display: inline-grid;
    place-items: center;
    width: 23px;
    height: 23px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--yellow);
    color: #17212B;
    font-weight: 900;
}

.subscription-price-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 13px;
    padding: 28px;
    border-radius: 18px;
    background: var(--navy);
    color: var(--white);
}

.subscription-price-panel > span {
    color: #E3EBFF;
    font-size: .88rem;
}

.subscription-price-panel strong {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
}

.subscription-price-panel .btn {
    width: 100%;
    margin-top: 8px;
}

/* =========================================
   SAFETY
========================================= */

.safety-section {
    padding: 30px 0;
    background: #FFF9E5;
}

.safety-inner {
    display: flex;
    align-items: flex-start;
    gap: 18px;
}

.safety-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--yellow);
    color: #17212B;
    font-size: 1.4rem;
    font-weight: 900;
}

.safety-inner h2 {
    margin: 0 0 5px;
    font-size: 1.08rem;
}

.safety-inner p {
    max-width: 950px;
    margin: 0;
    color: #596579;
    font-size: .9rem;
}

/* =========================================
   FOOTER
========================================= */

.site-footer {
    padding-top: 60px;
    background: #08275C;
    color: var(--white);
}

.footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    gap: 38px;
    padding-bottom: 45px;
}

.footer-logo {
    width: 185px;
    max-height: 65px;
    object-fit: contain;
}

.footer-brand p {
    max-width: 330px;
    margin: 20px 0 12px;
    color: #D7E2F7;
    font-size: .92rem;
}

.footer-tagline {
    color: var(--yellow);
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
}

.footer-column h3 {
    margin: 0 0 7px;
    font-size: 1rem;
}

.footer-column a {
    color: #D7E2F7;
    font-size: .88rem;
    overflow-wrap: anywhere;
}

.footer-column a:hover {
    color: var(--yellow);
}

.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,.16);
    color: #D7E2F7;
    font-size: .84rem;
}

.footer-bottom p {
    margin: 0;
}

.footer-credit strong {
    color: var(--yellow);
}

/* =========================================
   SUBSCRIPTION DIALOG
========================================= */

.subscription-dialog {
    width: min(460px, calc(100% - 30px));
    padding: 0;
    border: 0;
    border-radius: 22px;
    box-shadow: 0 25px 90px rgba(0,0,0,.25);
}

.subscription-dialog::backdrop {
    background: rgba(5, 20, 48, .65);
    backdrop-filter: blur(3px);
}

.dialog-content {
    position: relative;
    padding: 40px 30px 32px;
    text-align: center;
}

.dialog-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--gray-white);
    font-size: 1.6rem;
}

.dialog-icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    border-radius: 18px;
    background: var(--yellow);
    color: var(--navy);
    font-size: 2rem;
    font-weight: 900;
}

.dialog-content h2 {
    margin: 0;
    font-size: 1.65rem;
}

.dialog-content p {
    margin: 15px 0 24px;
    color: var(--gray);
}

.dialog-content > .btn {
    width: 100%;
}

.dialog-login {
    display: inline-block;
    margin-top: 18px;
    color: var(--navy);
    font-size: .9rem;
    font-weight: 700;
}

/* =========================================
   RESPONSIVE TABLETS
========================================= */

@media (max-width: 1050px) {
    .main-navigation {
        gap: 13px;
    }

    .nav-link {
        font-size: .83rem;
    }

    .brand-logo {
        width: 155px;
    }

    .hero-grid {
        gap: 35px;
    }

    .features-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .listings-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* =========================================
   RESPONSIVE MOBILE
========================================= */

@media (max-width: 760px) {
    .container {
        width: min(100% - 30px, 560px);
    }

    .header-inner {
        min-height: 72px;
    }

    .brand-logo {
        width: 150px;
    }

    .mobile-menu-toggle {
        display: block;
        flex-shrink: 0;
    }

    .main-navigation {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        display: none;
        align-items: stretch;
        gap: 0;
        padding: 12px 20px 22px;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .main-navigation.is-open {
        display: flex;
        flex-direction: column;
    }

    .nav-link {
        padding: 13px 5px;
        border-bottom: 1px solid var(--border);
        font-size: .95rem;
    }

    .language-selector {
        padding: 13px 0;
    }

    .header-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        padding-top: 10px;
    }

    .hero-section {
        padding: 55px 0 65px;
    }

    .hero-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .hero-content h1 {
        font-size: clamp(2.3rem, 10vw, 3.5rem);
        letter-spacing: -1.2px;
    }

    .hero-description {
        font-size: 1rem;
    }

    .hero-visual {
        min-height: 330px;
    }

    .hero-image-main {
        inset: 0 22px 25px 8px;
    }

    .hero-floating-card {
        left: 0;
        bottom: 8px;
    }

    .hero-image-secondary {
        width: 38%;
        height: 40%;
    }

    .features-section,
    .marketplace-section,
    .subscription-section {
        padding: 55px 0;
    }

    .features-grid {
        gap: 13px;
    }

    .feature-item {
        padding: 20px 15px;
    }

    .feature-item h3 {
        font-size: .96rem;
    }

    .feature-item p {
        font-size: .84rem;
    }

    .marketplace-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .listings-grid {
        grid-template-columns: 1fr;
    }

    .listing-description {
        min-height: auto;
    }

    .post-cta-section {
        padding: 55px 0;
    }

    .post-cta-content {
        align-items: flex-start;
        flex-direction: column;
    }

    .post-cta-content .btn {
        width: 100%;
    }

    .subscription-card {
        grid-template-columns: 1fr;
        gap: 25px;
        padding: 22px;
    }

    .subscription-price-panel {
        padding: 24px;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
        gap: 30px 20px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
    }
}

/* =========================================
   SMALL PHONES
========================================= */

@media (max-width: 390px) {
    .hero-actions {
        flex-direction: column;
    }

    .hero-actions .btn {
        width: 100%;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .listing-card {
        padding: 17px;
    }

    .listing-actions {
        grid-template-columns: 1fr;
    }

    .marketplace-filters {
        align-items: stretch;
        flex-direction: column;
    }

    .filter-btn {
        text-align: left;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}

/* Vector profile avatars */

.profile-avatar.vector-avatar {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid #DCE5F5;
}

.vector-avatar svg {
    display: block;
    width: 100%;
    height: 100%;
}

.avatar-blue {
    background: #DCE9FF;
}

.avatar-yellow {
    background: #FFF0B3;
}

.avatar-neutral {
    background: #E9EDF2;
}

.avatar-blue svg,
.avatar-yellow svg,
.avatar-neutral svg {
    width: 100%;
    height: 100%;
}
